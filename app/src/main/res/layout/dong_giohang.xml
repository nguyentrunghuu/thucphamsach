<?xml version="1.0" encoding="utf-8"?>
<!-- Một sản phẩm trong giỏ hàng -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/constraint_item_gio_hang"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/ui_surface"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/ui_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp">

        <androidx.cardview.widget.CardView
            android:layout_width="84dp"
            android:layout_height="84dp"
            app:cardBackgroundColor="@color/ui_surface_alt"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/img_giohang"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Ảnh sản phẩm"
                android:scaleType="centerCrop"
                android:src="@drawable/logo3" />
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_ten_giohang"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/be_vietnam_pro"
                android:maxLines="2"
                android:text="Tên sản phẩm"
                android:textColor="@color/ui_text"
                android:textFontWeight="600"
                android:textSize="15sp" />

            <!-- Đơn giá × trọng lượng -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_giatien_giohang"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="25.000"
                    android:textColor="@color/ui_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/textView19"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" đ / "
                    android:textColor="@color/ui_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_trongluong_giohang"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="500g"
                    android:textColor="@color/ui_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Thành tiền + chọn số lượng -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_total_giohang"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:text="50.000"
                    android:textColor="@color/ui_price"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textView21"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:text=" đ"
                    android:textColor="@color/ui_price"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_qty_stepper"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="3dp">

                    <ImageView
                        android:id="@+id/btn_minus_giohang"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="@drawable/bg_qty_button"
                        android:contentDescription="Giảm"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:padding="7dp"
                        android:src="@drawable/ic_ui_remove"
                        app:tint="@color/ui_green_text" />

                    <TextView
                        android:id="@+id/tv_number_giohang"
                        android:layout_width="34dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/be_vietnam_pro"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="@color/ui_text"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/btn_plus_giohang"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="@drawable/bg_btn_add_round"
                        android:contentDescription="Tăng"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:padding="7dp"
                        android:src="@drawable/ic_ui_add"
                        app:tint="#FFFFFF" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Giữ id cũ để tương thích -->
        <TextView
            android:id="@+id/textView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
