<?xml version="1.0" encoding="utf-8"?>
<!-- Tin nhắn bên phải (của mình). Dùng chung cho ChatBotAdapter và MessageAdapter. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end|bottom"
    android:orientation="horizontal"
    android:paddingStart="64dp"
    android:paddingTop="5dp"
    android:paddingEnd="12dp"
    android:paddingBottom="5dp">

    <TextView
        android:id="@+id/tv_seen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:text="Đã xem"
        android:textColor="@color/ui_text_hint"
        android:textSize="10sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_show_msg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_chat_bubble_user"
        android:lineSpacingMultiplier="1.3"
        android:maxWidth="280dp"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:text="Message"
        android:textColor="#FFFFFF"
        android:textIsSelectable="true"
        android:textSize="15sp" />

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/img_chat"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="8dp"
        android:src="@drawable/logo_new"
        android:visibility="gone"
        app:civ_border_color="#E6ECE6"
        app:civ_border_width="1dp" />

</LinearLayout>
