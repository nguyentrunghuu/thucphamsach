<?xml version="1.0" encoding="utf-8"?>
<!-- Thống kê doanh thu admin: toolbar → chip chọn kỳ → thẻ doanh thu → biểu đồ cột →
     đơn theo trạng thái → ghi chú đơn chưa giao → xuất Excel -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/admin_beige"
    android:orientation="vertical"
    tools:context=".View.Admin.AdminChartBillActivity">

    <include layout="@layout/view_admin_toolbar" />

    <!-- Chọn kỳ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/admin_surface"
        android:orientation="vertical"
        android:paddingTop="@dimen/admin_space_m"
        android:paddingBottom="@dimen/admin_space_s">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_period"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/admin_screen_padding"
                android:paddingEnd="@dimen/admin_screen_padding"
                app:chipSpacingHorizontal="@dimen/admin_space_s"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_period_7"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="7 ngày"
                    app:checkedIconVisible="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_period_30"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="30 ngày"
                    app:checkedIconVisible="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_period_month"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Tháng này"
                    app:checkedIconVisible="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_period_year"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Năm nay"
                    app:checkedIconVisible="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_period_custom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chọn ngày…"
                    app:checkedIconVisible="false" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <TextView
            android:id="@+id/tv_range"
            style="@style/Admin.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/admin_screen_padding"
            android:layout_marginTop="@dimen/admin_space_s"
            android:layout_marginEnd="@dimen/admin_screen_padding" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/chart_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/admin_screen_padding">

            <!-- Thẻ doanh thu -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Admin.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/admin_primary"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/admin_card_padding">

                    <TextView
                        style="@style/Admin.Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Doanh thu (đơn đã giao)"
                        android:textColor="@color/admin_on_header_soft" />

                    <TextView
                        android:id="@+id/tv_revenue"
                        style="@style/Admin.Text.StatValue"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="2dp"
                        android:autoSizeMaxTextSize="32sp"
                        android:autoSizeMinTextSize="18sp"
                        android:autoSizeTextType="uniform"
                        android:maxLines="1"
                        android:text="—"
                        android:textColor="@color/white" />

                    <TextView
                        android:id="@+id/tv_delta"
                        style="@style/Admin.Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/admin_space_xs"
                        android:textColor="@color/admin_on_header_soft" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/admin_space_m"
                        android:layout_marginBottom="@dimen/admin_space_m"
                        android:background="#33FFFFFF" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <include
                            android:id="@+id/mini_delivered"
                            layout="@layout/item_admin_mini_stat"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />

                        <include
                            android:id="@+id/mini_average"
                            layout="@layout/item_admin_mini_stat"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />

                        <include
                            android:id="@+id/mini_cancelled"
                            layout="@layout/item_admin_mini_stat"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Biểu đồ -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Admin.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/admin_card_gap">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/admin_card_padding">

                    <TextView
                        android:id="@+id/tv_chart_title"
                        style="@style/Admin.Text.Section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/tv_chart_hint"
                        style="@style/Admin.Text.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:layout_marginTop="@dimen/admin_space_s">

                        <com.github.mikephil.charting.charts.BarChart
                            android:id="@+id/barchart"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <TextView
                            android:id="@+id/tv_chart_empty"
                            style="@style/Admin.Text.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="Chưa có đơn đã giao trong kỳ này"
                            android:visibility="gone" />
                    </FrameLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Đơn theo trạng thái -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Admin.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/admin_card_gap">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/admin_card_padding">

                    <TextView
                        android:id="@+id/tv_status_title"
                        style="@style/Admin.Text.Section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Đơn theo trạng thái" />

                    <LinearLayout
                        android:id="@+id/status_rows"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/admin_space_s"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Nhận xét AI -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Admin.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/admin_card_gap">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/admin_card_padding">

                    <TextView
                        style="@style/Admin.Text.Section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Nhận xét của AI" />

                    <TextView
                        android:id="@+id/tv_ai_insight"
                        style="@style/Admin.Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/admin_space_s"
                        android:lineSpacingMultiplier="1.15"
                        android:text="Bấm nút bên dưới để AI đọc số liệu của kỳ này và gợi ý việc nên làm."
                        android:textColor="@color/admin_text_muted"
                        android:textIsSelectable="true" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_ai_insight"
                        style="@style/Admin.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/admin_space_m"
                        android:text="Phân tích kỳ này" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Ghi chú đơn chưa giao xong -->
            <TextView
                android:id="@+id/tv_unfinished"
                style="@style/Admin.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/admin_card_gap"
                android:background="@drawable/bg_admin_badge"
                android:backgroundTint="@color/admin_warning_soft"
                android:padding="@dimen/admin_space_l"
                android:textColor="@color/admin_warning_text"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_export"
                style="@style/Admin.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/admin_card_gap"
                android:text="Xuất Excel đơn đã giao" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
