<?xml version="1.0" encoding="utf-8"?>
<!-- Một đơn trong danh sách shipper — ShipperOrderAdapter -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_shipper_order"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/admin_card_gap"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="@dimen/admin_radius_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/admin_card_padding">

        <!-- Mã đơn + trạng thái -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_order_id"
                style="@style/Admin.Text.Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="TPS0512250010TM" />

            <TextView
                android:id="@+id/tv_status"
                style="@style/Admin.Badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/admin_space_s"
                tools:text="Đã xác nhận" />
        </LinearLayout>

        <!-- Người nhận + nút gọi -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/admin_space_xs"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_customer_name"
                    style="@style/Admin.Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    tools:text="Hữu Tình" />

                <TextView
                    android:id="@+id/tv_phone"
                    style="@style/Admin.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    tools:text="0349132622" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_call"
                android:layout_width="@dimen/admin_touch_min"
                android:layout_height="@dimen/admin_touch_min"
                android:background="@drawable/bg_admin_icon_box"
                android:backgroundTint="@color/admin_primary_soft"
                android:contentDescription="Gọi khách"
                android:src="@drawable/ic_ui_call"
                app:tint="@color/admin_primary" />
        </LinearLayout>

        <!-- Địa chỉ -->
        <TextView
            android:id="@+id/tv_address"
            style="@style/Admin.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/admin_space_s"
            android:drawableStart="@drawable/ic_ui_location"
            android:drawablePadding="@dimen/admin_space_s"
            android:drawableTint="@color/admin_text_muted"
            android:ellipsize="end"
            android:maxLines="2"
            android:textSize="14sp"
            tools:text="Khu nhà ở thái bình, Đường Tân Hiệp 17, Tân Uyên, Bình Dương" />

        <TextView
            android:id="@+id/tv_slot"
            style="@style/Admin.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/admin_space_xs"
            android:visibility="gone"
            tools:text="Giao: 15/11/2026 · 9h-11h" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/admin_space_m"
            android:layout_marginBottom="@dimen/admin_space_m"
            android:background="@color/admin_outline" />

        <!-- Thanh toán / số tiền thu -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_payment"
                style="@style/Admin.Text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:autoSizeMaxTextSize="18sp"
                android:autoSizeMinTextSize="12sp"
                android:autoSizeTextType="uniform"
                android:maxLines="1"
                android:paddingEnd="@dimen/admin_space_s"
                android:textStyle="bold"
                tools:text="Thu hộ 370.000 đ" />

            <TextView
                android:id="@+id/tv_action_hint"
                style="@style/Admin.Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableEnd="@drawable/ic_ui_chevron_right"
                android:drawableTint="@color/admin_text_muted"
                android:gravity="center_vertical"
                tools:text="Xem chi tiết" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
