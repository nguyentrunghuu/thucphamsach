<?xml version="1.0" encoding="utf-8"?>
<!-- Dòng sản phẩm cần chú ý (sắp hết hàng / sắp hết hạn) trên dashboard — AdminAttentionAdapter -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingTop="@dimen/admin_space_s"
    android:paddingBottom="@dimen/admin_space_s">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/img_attention"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@color/admin_beige"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/Admin.Shape.Rounded" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/admin_space_m"
        android:layout_marginEnd="@dimen/admin_space_s"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_attention_name"
            style="@style/Admin.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_attention_sub"
            style="@style/Admin.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_badge_expiry"
            style="@style/Admin.Badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tv_badge_stock"
            style="@style/Admin.Badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />
    </LinearLayout>
</LinearLayout>
