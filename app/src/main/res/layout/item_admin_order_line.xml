<?xml version="1.0" encoding="utf-8"?>
<!-- Một sản phẩm trong chi tiết đơn admin — AdminCTHDAdapter -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="@dimen/admin_space_s"
    android:paddingBottom="@dimen/admin_space_s">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/img_order_line"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@color/admin_beige"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/Admin.Shape.Rounded" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/admin_space_m"
        android:layout_marginEnd="@dimen/admin_space_s"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_order_line_name"
            style="@style/Admin.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textStyle="bold"
            tools:text="Bạch tuộc" />

        <TextView
            android:id="@+id/tv_order_line_qty"
            style="@style/Admin.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="13sp"
            tools:text="2 × 17.500 đ" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_order_line_total"
        style="@style/Admin.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textStyle="bold"
        tools:text="35.000 đ" />
</LinearLayout>
