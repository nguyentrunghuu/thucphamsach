<?xml version="1.0" encoding="utf-8"?>
<!-- Màn chính của shipper: toolbar → 3 tab (Đơn mới / Đang giao / Đã giao, kèm số đơn) → danh sách -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/admin_beige"
    android:orientation="vertical"
    tools:context=".View.Shipper.ShipperHomeActivity">

    <include layout="@layout/view_admin_toolbar" />

    <!-- Ô tìm kiếm (tên, SĐT, mã đơn, địa chỉ; không phân biệt dấu) -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/admin_surface"
        android:paddingStart="@dimen/admin_screen_padding"
        android:paddingTop="@dimen/admin_space_m"
        android:paddingEnd="@dimen/admin_screen_padding"
        app:endIconMode="clear_text"
        app:hintEnabled="false"
        app:startIconDrawable="@drawable/ic_search"
        app:startIconTint="@color/admin_text_muted">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edt_search_shipper"
            style="@style/Admin.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tên, SĐT, mã đơn, địa chỉ…"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:textColorHint="@color/admin_text_muted" />
    </com.google.android.material.textfield.TextInputLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/admin_surface"
        android:paddingTop="@dimen/admin_space_m"
        android:paddingBottom="@dimen/admin_space_m"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_shipper_tabs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/admin_screen_padding"
            android:paddingEnd="@dimen/admin_screen_padding"
            app:chipSpacingHorizontal="@dimen/admin_space_s"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_tab_new"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Đơn mới"
                app:checkedIconVisible="false" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_tab_active"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đang giao"
                app:checkedIconVisible="false" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_tab_done"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đã giao"
                app:checkedIconVisible="false" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rcv_shipper_orders"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="@dimen/admin_screen_padding" />

        <ProgressBar
            android:id="@+id/progress_shipper"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/admin_primary" />

        <include layout="@layout/view_admin_empty" />
    </FrameLayout>
</LinearLayout>
