<?xml version="1.0" encoding="utf-8"?>
<!-- Shipper trang admin: toolbar → danh sách → nút thêm -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/admin_beige"
    android:orientation="vertical"
    tools:context=".View.Admin.AdminShipperActivity">

    <include layout="@layout/view_admin_toolbar" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rcv_shippers"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/admin_screen_padding"
            android:paddingTop="@dimen/admin_space_m"
            android:paddingEnd="@dimen/admin_screen_padding"
            android:paddingBottom="96dp"
            tools:listitem="@layout/dong_admin_shipper" />

        <include
            layout="@layout/view_admin_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/admin_space_xl" />

        <ProgressBar
            android:id="@+id/progress_shippers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="48dp"
            android:indeterminateTint="@color/admin_primary" />

        <FrameLayout
            android:id="@+id/fab_container_shipper"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:padding="@dimen/admin_space_l">

            <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
                android:id="@+id/fab_add_shipper"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/be_vietnam_pro"
                android:letterSpacing="0"
                android:text="Thêm shipper"
                android:textAllCaps="false"
                android:textColor="@color/white"
                app:backgroundTint="@color/admin_primary"
                app:icon="@drawable/ic_ui_add"
                app:iconTint="@color/white" />
        </FrameLayout>
    </FrameLayout>
</LinearLayout>
