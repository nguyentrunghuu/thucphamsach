<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/auth_gradient_background"
    tools:context=".View.ForgotPasswordActivity">

    <!-- Decorative Elements -->
    <View
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="-100dp"
        android:layout_marginEnd="-100dp"
        android:background="@drawable/circle_decorative"
        android:alpha="0.15"/>

    <View
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_alignParentStart="true"
        android:layout_marginTop="200dp"
        android:layout_marginStart="-50dp"
        android:background="@drawable/circle_decorative"
        android:alpha="0.1"/>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="60dp"
            android:paddingBottom="40dp">

            <!-- Icon Section -->
            <androidx.cardview.widget.CardView
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_marginBottom="32dp"
                app:cardCornerRadius="50dp"
                app:cardElevation="12dp"
                app:cardBackgroundColor="#FFFFFF">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_email"
                    android:scaleType="centerInside"
                    android:padding="20dp"
                    android:tint="#2196F3" />
            </androidx.cardview.widget.CardView>

            <!-- Title Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quên mật khẩu?"
                android:textColor="#FFFFFF"
                android:textSize="32sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"
                android:letterSpacing="0.02" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nhập email để nhận link đặt lại mật khẩu"
                android:textColor="#E3F2FD"
                android:textSize="16sp"
                android:gravity="center"
                android:layout_marginBottom="40dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />

            <!-- Form Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="28dp"
                app:cardElevation="16dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- Email Input -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Email"
                            android:textColor="#757575"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp" />

                        <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
                            app:boxCornerRadiusBottomStart="16dp"
                            app:boxCornerRadiusBottomEnd="16dp"
                            app:boxCornerRadiusTopStart="16dp"
                            app:boxCornerRadiusTopEnd="16dp"
                            app:boxStrokeWidth="0dp"
                            app:boxStrokeWidthFocused="0dp"
                            app:hintEnabled="false"
                            android:background="@drawable/auth_input_background"
                            android:padding="4dp">

    <EditText
                                android:id="@+id/edt_email_forgot"
                                android:layout_width="match_parent"
                                android:layout_height="60dp"
                                android:hint="Nhập Email"
                                android:inputType="textEmailAddress"
                                android:singleLine="true"
                                android:paddingStart="16dp"
                                android:paddingEnd="16dp"
                                android:textSize="15sp"
                                android:textColorHint="#9E9E9E"
                                android:drawableStart="@drawable/ic_email"
                                android:drawablePadding="12dp"
                                android:background="@android:color/transparent" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <!-- Old Password Input (if needed) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="24dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mật khẩu cũ (nếu có)"
                            android:textColor="#757575"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp" />

                        <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
                            app:boxCornerRadiusBottomStart="16dp"
                            app:boxCornerRadiusBottomEnd="16dp"
                            app:boxCornerRadiusTopStart="16dp"
                            app:boxCornerRadiusTopEnd="16dp"
                            app:boxStrokeWidth="0dp"
                            app:boxStrokeWidthFocused="0dp"
                            app:passwordToggleEnabled="true"
                            app:passwordToggleTint="#2196F3"
                            app:hintEnabled="false"
                            android:background="@drawable/auth_input_background"
                            android:padding="4dp">

                            <EditText
        android:id="@+id/edt_pass_forgot"
                                android:layout_width="match_parent"
                                android:layout_height="60dp"
                                android:hint="Nhập mật khẩu cũ"
                                android:inputType="textPassword"
                                android:singleLine="true"
                                android:paddingStart="16dp"
                                android:paddingEnd="16dp"
                                android:textSize="15sp"
                                android:textColorHint="#9E9E9E"
                                android:background="@android:color/transparent" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <!-- Send Button -->
    <Button
        android:id="@+id/btn_forgot"
        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:text="Gửi yêu cầu"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/button_blue_gradient"
                        android:elevation="8dp"
                        android:letterSpacing="0.02" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

</LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
