<?xml version="1.0" encoding="utf-8"?>
<!-- Một sản phẩm trong chi tiết đơn (khách) — CTHDActivity -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:id="@+id/row_line_click"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/img_line"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_order_thumb"
            android:clipToOutline="true"
            android:contentDescription="@null"
            android:outlineProvider="background"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_line_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/be_vietnam_pro"
                android:maxLines="2"
                android:textColor="@color/ui_text"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Củ Sắn" />

            <TextView
                android:id="@+id/tv_line_unit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/be_vietnam_pro"
                android:textColor="@color/ui_text_secondary"
                android:textSize="13sp"
                tools:text="40.000 đ × 1" />

            <TextView
                android:id="@+id/tv_line_total"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/be_vietnam_pro"
                android:textColor="@color/ui_price"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="40.000 đ" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_line_review"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="end"
        android:layout_marginTop="8dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="★  Đánh giá"
        android:textColor="@color/ui_green_text"
        android:visibility="gone"
        app:cornerRadius="12dp"
        app:strokeColor="#A5D6A7" />
</LinearLayout>
