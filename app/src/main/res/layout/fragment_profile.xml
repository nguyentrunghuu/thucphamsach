<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F8F5">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="120dp">

            <!-- HEADER: ảnh đại diện + email -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:background="@drawable/bg_home_header" />

                <!-- Nút đăng xuất góc trên phải -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/layout_logout"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    app:cardBackgroundColor="#33FFFFFF"
                    app:cardCornerRadius="21dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="Đăng xuất"
                        android:src="@drawable/ic_baseline_logout_24"
                        app:tint="#FFFFFF" />
                </androidx.cardview.widget.CardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="24dp"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:text="Tài khoản"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="76dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <FrameLayout
                        android:id="@+id/avatar_container"
                        android:layout_width="112dp"
                        android:layout_height="112dp">

                        <de.hdodenhof.circleimageview.CircleImageView
                            android:id="@+id/img_avatar"
                            android:layout_width="112dp"
                            android:layout_height="112dp"
                            android:src="@drawable/ic_avatar_default"
                            app:civ_border_color="#FFFFFF"
                            app:civ_border_width="4dp"
                            app:civ_circle_background_color="#E8F5E9" />

                        <ImageView
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_gravity="bottom|end"
                            android:background="@drawable/bg_camera_badge"
                            android:contentDescription="Đổi ảnh đại diện"
                            android:padding="7dp"
                            android:src="@drawable/ic_camera"
                            app:tint="#FFFFFF" />
                    </FrameLayout>

                    <!-- Bấm vào email để đổi email -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="20dp">

                        <TextView
                            android:id="@+id/tv_email_profile"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="@font/be_vietnam_pro"
                            android:maxLines="1"
                            android:text="email@example.com"
                            android:textColor="#1A1A1A"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginStart="6dp"
                            android:contentDescription="Đổi email"
                            android:src="@drawable/ic_baseline_edit_24"
                            app:tint="#7A847A" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Chạm vào ảnh hoặc email để thay đổi"
                        android:textColor="#9AA39A"
                        android:textSize="12sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- THÔNG TIN CÁ NHÂN -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="#EDF2ED"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/be_vietnam_pro"
                        android:text="Thông tin cá nhân"
                        android:textColor="#1A1A1A"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView style="@style/ProfileLabel" android:text="Họ và tên" />

                    <EditText
                        android:id="@+id/edt_full_name"
                        style="@style/DialogInput"
                        android:hint="Nhập họ và tên"
                        android:inputType="textPersonName|textCapWords"
                        android:singleLine="true" />

                    <TextView style="@style/ProfileLabel" android:text="Số điện thoại" />

                    <EditText
                        android:id="@+id/edt_phone"
                        style="@style/DialogInput"
                        android:hint="Nhập số điện thoại"
                        android:inputType="phone"
                        android:singleLine="true" />

                    <TextView style="@style/ProfileLabel" android:text="Ngày sinh" />

                    <EditText
                        android:id="@+id/edt_date"
                        style="@style/DialogInput"
                        android:clickable="false"
                        android:cursorVisible="false"
                        android:drawableEnd="@drawable/icons8_calendar"
                        android:focusable="false"
                        android:hint="Chọn ngày sinh"
                        android:singleLine="true" />

                    <TextView style="@style/ProfileLabel" android:text="Giới tính" />

                    <RadioGroup
                        android:id="@+id/rdo_group"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_info_tile"
                        android:orientation="horizontal"
                        android:padding="4dp">

                        <RadioButton
                            android:id="@+id/rdo_nam"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/bg_segment"
                            android:button="@null"
                            android:gravity="center"
                            android:text="Nam"
                            android:textColor="@color/segment_text"
                            android:textFontWeight="600"
                            android:textSize="14sp" />

                        <RadioButton
                            android:id="@+id/rdo_nu"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/bg_segment"
                            android:button="@null"
                            android:gravity="center"
                            android:text="Nữ"
                            android:textColor="@color/segment_text"
                            android:textFontWeight="600"
                            android:textSize="14sp" />
                    </RadioGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ĐỊA CHỈ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="#EDF2ED"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:fontFamily="@font/be_vietnam_pro"
                        android:text="Địa chỉ giao hàng"
                        android:textColor="#1A1A1A"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_selected_address_profile"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_info_tile"
                        android:drawableStart="@drawable/ic_ui_location"
                        android:drawablePadding="10dp"
                        android:drawableTint="#2E7D32"
                        android:gravity="center_vertical"
                        android:lineSpacingMultiplier="1.2"
                        android:padding="12dp"
                        android:text="Chưa có địa chỉ"
                        android:textColor="#1A1A1A"
                        android:textSize="14sp"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/btn_select_address_profile"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_outline_button"
                        android:fontFamily="@font/be_vietnam_pro"
                        android:stateListAnimator="@null"
                        android:text="Chọn địa chỉ trên bản đồ"
                        android:textAllCaps="false"
            android:letterSpacing="0"
                        android:textColor="#2E7D32"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:backgroundTint="@null" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <Button
                android:id="@+id/btn_update_profile"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_primary_button"
                android:fontFamily="@font/be_vietnam_pro"
                android:stateListAnimator="@null"
                android:text="Lưu thay đổi"
                android:textAllCaps="false"
            android:letterSpacing="0"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

            <!-- Đăng xuất -->
            <androidx.cardview.widget.CardView
                android:id="@+id/layout_logout_bottom"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="#FFEBEE"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_baseline_logout_24"
                        app:tint="#C62828" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/be_vietnam_pro"
                        android:text="Đăng xuất"
                        android:textColor="#C62828"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
