<?xml version="1.0" encoding="utf-8"?>
<!-- Nội dung hộp thoại đặt quy tắc khuyến mãi cho một loại (AdminPromotionActivity) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/admin_space_xl"
    android:paddingTop="@dimen/admin_space_s"
    android:paddingEnd="@dimen/admin_space_xl">

    <TextView
        style="@style/Admin.Text.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/admin_space_m"
        android:text="Khi khách mua từ số lượng này trở lên các sản phẩm thuộc loại, tiền của loại đó được giảm theo phần trăm." />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_promo_min"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Mua từ (số sản phẩm) *"
        app:suffixText="sản phẩm">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edt_promo_min"
            style="@style/Admin.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionNext"
            android:inputType="number"
            android:maxLength="2"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_promo_percent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/admin_space_s"
        android:hint="Giảm giá *"
        app:suffixText="%">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edt_promo_percent"
            style="@style/Admin.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionDone"
            android:inputType="number"
            android:maxLength="3"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/tv_promo_preview"
        style="@style/Admin.Text.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/admin_space_s"
        android:textColor="@color/admin_accent_text" />
</LinearLayout>
