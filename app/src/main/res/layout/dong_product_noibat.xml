<?xml version="1.0" encoding="utf-8"?>
<!-- Thẻ sản phẩm trên trang chủ (lưới 2 cột). Cả thẻ bấm được để mở chi tiết. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_product"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:rippleColor="#1A2E7D32"
    app:strokeColor="#EDF2ED"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- Ảnh sản phẩm -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_image"
            android:layout_width="match_parent"
            android:layout_height="130dp"
            app:cardBackgroundColor="#F4F7F4"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/img_product"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Ảnh sản phẩm"
                android:scaleType="centerCrop"
                android:src="@drawable/dashboard2" />
        </androidx.cardview.widget.CardView>

        <!-- Loại sản phẩm -->
        <TextView
            android:id="@+id/tv_loaisp_product"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_pill_green_light"
            android:fontFamily="@font/be_vietnam_pro" android:textFontWeight="500"
            android:maxLines="1"
            android:ellipsize="end"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="Rau củ"
            android:textColor="#2E7D32"
            android:textSize="11sp"
            android:visibility="gone" />

        <!-- Tên sản phẩm (cố định 2 dòng để các thẻ cao bằng nhau) -->
        <TextView
            android:id="@+id/tv_ten_product"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="4dp"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:fontFamily="@font/be_vietnam_pro" android:textFontWeight="600"
            android:lines="2"
            android:lineSpacingMultiplier="1.1"
            android:text="Tên sản phẩm"
            android:textColor="#1A1A1A"
            android:textSize="14sp" />

        <!-- Giá + nút thêm -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_giatien_product"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/be_vietnam_pro" android:textStyle="bold"
                android:text="25.000"
                android:textColor="#E65100"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/textView14"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/be_vietnam_pro" android:textStyle="bold"
                android:text=" đ"
                android:textColor="#E65100"
                android:textSize="13sp" />

            <!-- Chỉ là biểu tượng; bấm vào sẽ mở chi tiết như cả thẻ -->
            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_btn_add_round"
                android:contentDescription="Thêm vào giỏ"
                android:duplicateParentState="true"
                android:padding="6dp"
                android:src="@drawable/ic_ui_add"
                app:tint="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
