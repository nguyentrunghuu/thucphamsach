<?xml version="1.0" encoding="utf-8"?>
<!-- Dialog đánh giá sản phẩm: rộng theo màn hình (do CTHDActivity đặt), phần nội dung cuộn được,
     nút Hủy/Gửi luôn nằm ở đáy nên không bao giờ bị tràn khỏi màn hình hay bị bàn phím che. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_review_dialog"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_review_dialog_header"
        android:gravity="center"
        android:padding="16dp"
        android:text="Đánh giá sản phẩm"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/img_danhgia"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/search_bar_background"
                    android:padding="6dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_add_cart" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_name_danhgia"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="@color/ui_text"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Số lượng: "
                            android:textColor="@color/ui_text_secondary"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tv_number_danhgia"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/ui_green_text"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bạn có hài lòng về sản phẩm?"
                android:textColor="@color/ui_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rdg_danhgia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp">

                <RadioButton
                    android:id="@+id/rdo_danhgia_tot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="#2E7D32"
                    android:minHeight="44dp"
                    android:text="Sản phẩm rất tốt"
                    android:textColor="@color/ui_text" />

                <RadioButton
                    android:id="@+id/rdo_danhgia_khongtot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="#2E7D32"
                    android:minHeight="44dp"
                    android:text="Không hài lòng"
                    android:textColor="@color/ui_text" />

                <RadioButton
                    android:id="@+id/rdo_danhgia_khac"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="#2E7D32"
                    android:minHeight="44dp"
                    android:text="Khác"
                    android:textColor="@color/ui_text" />
            </RadioGroup>

            <EditText
                android:id="@+id/edt_danhgia_khac"
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:background="@drawable/auth_input_background"
                android:gravity="top|start"
                android:hint="Nhập nhận xét của bạn..."
                android:inputType="textMultiLine|textCapSentences"
                android:maxLines="5"
                android:padding="12dp"
                android:textColorHint="@color/ui_text_hint"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="Chọn số sao"
                android:textColor="@color/ui_text_secondary"
                android:textSize="14sp" />

            <RatingBar
                android:id="@+id/rating_danhgia"
                style="@style/Widget.AppCompat.RatingBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:numStars="5"
                android:progressBackgroundTint="@color/ui_stroke"
                android:progressTint="#FFC107"
                android:rating="5"
                android:secondaryProgressTint="#FFC107"
                android:stepSize="0.5" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_danhgia_huy"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="Hủy"
            android:textColor="@color/ui_green_text"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            app:strokeColor="@color/ui_green_text"
            app:strokeWidth="1.5dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_danhgia_gui"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Gửi"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:backgroundTint="#2E7D32"
            app:cornerRadius="14dp" />
    </LinearLayout>
</LinearLayout>
