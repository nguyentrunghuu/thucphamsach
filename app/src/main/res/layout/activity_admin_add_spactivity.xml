<?xml version="1.0" encoding="utf-8"?>
<!-- Thêm / sửa sản phẩm (AdminAddSPActivity): toolbar → ảnh → thông tin cơ bản → kho & hạn dùng
     → mô tả → thanh nút cố định ở đáy (Xóa khi sửa + Lưu). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/admin_beige"
    android:orientation="vertical"
    tools:context=".View.Admin.AdminAddSPActivity">

    <include layout="@layout/view_admin_toolbar" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/form_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/admin_screen_padding">

            <!-- ===== Ảnh ===== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/admin_card_padding">

                    <FrameLayout
                        android:layout_width="112dp"
                        android:layout_height="112dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/image_add"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@color/admin_beige"
                            android:contentDescription="Ảnh sản phẩm"
                            android:foreground="?attr/selectableItemBackground"
                            android:scaleType="centerCrop"
                            app:shapeAppearanceOverlay="@style/Admin.Shape.Rounded" />

                        <ImageView
                            android:id="@+id/img_image_placeholder"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_camera"
                            app:tint="@color/admin_text_muted" />

                        <ProgressBar
                            android:id="@+id/progress_image"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center"
                            android:indeterminateTint="@color/admin_primary"
                            android:visibility="gone" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/admin_space_l"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Admin.Text.Section"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ảnh sản phẩm" />

                        <TextView
                            android:id="@+id/tv_image_hint"
                            style="@style/Admin.Text.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Ảnh vuông, rõ nét, nền sáng" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_pick_image"
                            style="@style/Admin.Button.Outlined"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/admin_space_s"
                            android:text="Chọn ảnh"
                            app:icon="@drawable/ic_camera"
                            app:iconTint="@color/admin_primary" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== Thông tin cơ bản ===== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/admin_card_gap">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/admin_card_padding">

                    <TextView
                        style="@style/Admin.Text.Section"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/admin_space_m"
                        android:text="Thông tin cơ bản" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Tên sản phẩm *">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edt_tensp"
                            style="@style/Admin.Text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionNext"
                            android:inputType="textCapSentences"
                            android:maxLength="100"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_price"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/admin_space_s"
                        android:hint="Giá bán *"
                        app:suffixText="đ">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edt_giatiensp"
                            style="@style/Admin.Text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionNext"
                            android:inputType="number"
                            android:maxLength="12"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_category"
                        style="@style/Admin.TextField.Dropdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/admin_space_s"
                        android:hint="Danh mục *">

                        <AutoCompleteTextView
                            android:id="@+id/dd_category"
                            style="@style/Admin.Text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:paddingStart="16dp"
                            android:paddingTop="16dp"
                            android:paddingEnd="16dp"
                            android:paddingBottom="16dp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_add_category"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/be_vietnam_pro"
                        android:letterSpacing="0"
                        android:minHeight="@dimen/admin_touch_min"
                        android:text="Thêm danh mục mới"
                        android:textAllCaps="false"
                        android:textColor="@color/admin_primary"
                        app:icon="@drawable/ic_ui_add"
                        app:iconTint="@color/admin_primary" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_type"
                        style="@style/Admin.TextField.Dropdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Nhóm hiển thị"
                        app:helperText="Mục sản phẩm xuất hiện trên trang chủ">

                        <AutoCompleteTextView
                            android:id="@+id/dd_type"
                            style="@style/Admin.Text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:paddingStart="16dp"
                            android:paddingTop="16dp"
                            android:paddingEnd="16dp"
                            android:paddingBottom="16dp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== Kho & hạn dùng ===== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/admin_card_gap">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/admin_card_padding">

                    <TextView
                        style="@style/Admin.Text.Section"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/admin_space_m"
                        android:text="Kho và hạn dùng" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/til_quantity"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Số lượng *">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edt_soluongsp"
                                style="@style/Admin.Text"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:imeOptions="actionNext"
                                android:inputType="number"
                                android:maxLength="7"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/til_weight"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/admin_space_s"
                            android:layout_weight="1"
                            android:hint="Quy cách *"
                            app:placeholderText="vd. 500g, 1kg">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edt_trongluongsp"
                                style="@style/Admin.Text"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:imeOptions="actionDone"
                                android:inputType="text"
                                android:maxLength="30"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_expiry"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/admin_space_s"
                        android:hint="Hạn sử dụng *"
                        app:endIconDrawable="@drawable/ic_admin_calendar"
                        app:endIconMode="custom"
                        app:endIconTint="@color/admin_primary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edt_hansudungsp"
                            style="@style/Admin.Text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:cursorVisible="false"
                            android:focusable="false"
                            android:inputType="none"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== Mô tả ===== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/admin_card_gap">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/admin_card_padding">

                    <TextView
                        style="@style/Admin.Text.Section"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/admin_space_m"
                        android:text="Mô tả" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_origin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Xuất xứ"
                        app:helperText="Không bắt buộc, vd. Đà Lạt, Úc"
                        app:placeholderText="Nơi sản xuất / nuôi trồng">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edt_xuatxu"
                            style="@style/Admin.Text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionNext"
                            android:inputType="textCapSentences"
                            android:maxLength="60"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/admin_space_s"
                        android:hint="Mô tả chi tiết *">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edt_motasp"
                            style="@style/Admin.Text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="top|start"
                            android:inputType="textMultiLine|textCapSentences"
                            android:minLines="4" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_ai_description"
                        style="@style/Admin.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/admin_space_s"
                        android:text="Viết mô tả bằng AI" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ===== Thanh nút ===== -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/admin_outline" />

    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/admin_surface"
        android:orientation="horizontal"
        android:paddingStart="@dimen/admin_screen_padding"
        android:paddingTop="@dimen/admin_space_s"
        android:paddingEnd="@dimen/admin_screen_padding"
        android:paddingBottom="@dimen/admin_space_s">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_delete"
            style="@style/Admin.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/admin_space_s"
            android:text="Xóa"
            android:textColor="@color/admin_danger"
            android:visibility="gone"
            app:icon="@drawable/ic_ui_delete"
            app:iconTint="@color/admin_danger"
            app:strokeColor="@color/admin_danger" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Thêm sản phẩm" />
    </LinearLayout>
</LinearLayout>
