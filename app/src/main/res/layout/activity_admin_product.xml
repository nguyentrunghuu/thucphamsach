<?xml version="1.0" encoding="utf-8"?>
<!-- Danh sách sản phẩm admin: toolbar → ô tìm kiếm → chip trạng thái + chip loại → danh sách → nút thêm -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/admin_beige"
    android:orientation="vertical"
    tools:context=".View.Admin.AdminProductActivity">

    <include layout="@layout/view_admin_toolbar" />

    <!-- ===== Tìm kiếm + bộ lọc ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/admin_surface"
        android:orientation="vertical"
        android:paddingTop="@dimen/admin_space_m"
        android:paddingBottom="@dimen/admin_space_xs">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_search_product"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/admin_screen_padding"
            android:layout_marginEnd="@dimen/admin_screen_padding"
            android:hint="Tìm theo tên, loại, mô tả"
            app:endIconMode="clear_text"
            app:hintEnabled="false"
            app:startIconDrawable="@drawable/ic_search"
            app:startIconTint="@color/admin_text_muted">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edt_search_product"
                style="@style/Admin.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Tìm theo tên, loại, mô tả"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:textColorHint="@color/admin_text_muted" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Trạng thái -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/admin_space_s"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/admin_screen_padding"
                android:paddingEnd="@dimen/admin_screen_padding"
                app:chipSpacingHorizontal="@dimen/admin_space_s"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_status_all"
                    app:checkedIconVisible="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Tất cả" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_status_low_stock"
                    app:checkedIconVisible="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sắp hết hàng" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_status_expiry"
                    app:checkedIconVisible="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hết hạn / sắp hết hạn" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <!-- Loại sản phẩm (thêm bằng code từ LoaiProduct) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/admin_screen_padding"
                android:paddingEnd="@dimen/admin_screen_padding"
                app:chipSpacingHorizontal="@dimen/admin_space_s"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true" />
        </HorizontalScrollView>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/admin_outline" />

    <TextView
        android:id="@+id/tv_product_result"
        style="@style/Admin.Text.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/admin_screen_padding"
        android:paddingTop="@dimen/admin_space_s"
        android:paddingEnd="@dimen/admin_screen_padding"
        tools:text="74 sản phẩm" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rcv_admin_product"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/admin_screen_padding"
            android:paddingTop="@dimen/admin_space_s"
            android:paddingEnd="@dimen/admin_screen_padding"
            android:paddingBottom="96dp"
            tools:listitem="@layout/item_admin_product" />

        <include
            layout="@layout/view_admin_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/admin_space_xl" />

        <ProgressBar
            android:id="@+id/progress_admin_product"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="48dp"
            android:indeterminateTint="@color/admin_primary" />

        <!-- Khung bọc để chừa chỗ cho thanh điều hướng (edge-to-edge) -->
        <FrameLayout
            android:id="@+id/fab_container_product"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:padding="@dimen/admin_space_l">

            <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
                android:id="@+id/fab_add_product"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/be_vietnam_pro"
                android:letterSpacing="0"
                android:text="Thêm sản phẩm"
                android:textAllCaps="false"
                android:textColor="@color/white"
                app:backgroundTint="@color/admin_primary"
                app:icon="@drawable/ic_ui_add"
                app:iconTint="@color/white" />
        </FrameLayout>
    </FrameLayout>
</LinearLayout>
