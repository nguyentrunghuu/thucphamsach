<?xml version="1.0" encoding="utf-8"?>
<!-- Thêm / sửa danh mục (AdminAddLoaiSPActivity): toolbar → ảnh → tên → thanh nút Lưu cố định ở đáy -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/admin_beige"
    android:orientation="vertical"
    tools:context=".View.Admin.AdminAddLoaiSPActivity">

    <include layout="@layout/view_admin_toolbar" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/form_scroll_loai"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/admin_screen_padding">

            <!-- ===== Ảnh ===== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/admin_card_padding">

                    <FrameLayout
                        android:layout_width="96dp"
                        android:layout_height="96dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/image_them_loai"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@color/admin_beige"
                            android:contentDescription="Ảnh danh mục"
                            android:foreground="?attr/selectableItemBackground"
                            android:scaleType="centerCrop"
                            app:shapeAppearanceOverlay="@style/Admin.Shape.Rounded" />

                        <ImageView
                            android:id="@+id/img_loai_placeholder"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_camera"
                            app:tint="@color/admin_text_muted" />

                        <ProgressBar
                            android:id="@+id/progress_image_loai"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_gravity="center"
                            android:indeterminateTint="@color/admin_primary"
                            android:visibility="gone" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/admin_space_l"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Admin.Text.Section"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ảnh danh mục" />

                        <TextView
                            style="@style/Admin.Text.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Hiện ở trang chủ, nên dùng ảnh vuông, nền sáng" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_pick_image_loai"
                            style="@style/Admin.Button.Outlined"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/admin_space_s"
                            android:text="Chọn ảnh"
                            app:icon="@drawable/ic_camera"
                            app:iconTint="@color/admin_primary" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== Tên ===== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/admin_card_gap">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/admin_card_padding">

                    <TextView
                        style="@style/Admin.Text.Section"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/admin_space_m"
                        android:text="Thông tin" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_loai_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Tên danh mục *"
                        app:counterEnabled="true"
                        app:counterMaxLength="40">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edt_them_loai"
                            style="@style/Admin.Text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionDone"
                            android:inputType="textCapSentences"
                            android:maxLength="40"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/tv_loai_rename_note"
                        style="@style/Admin.Text.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/admin_space_s"
                        android:text="Đổi tên danh mục sẽ đổi theo cho tất cả sản phẩm thuộc danh mục này."
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/admin_outline" />

    <LinearLayout
        android:id="@+id/bottom_bar_loai"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/admin_surface"
        android:orientation="horizontal"
        android:paddingStart="@dimen/admin_screen_padding"
        android:paddingTop="@dimen/admin_space_s"
        android:paddingEnd="@dimen/admin_screen_padding"
        android:paddingBottom="@dimen/admin_space_s">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_them_loai"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Thêm danh mục" />
    </LinearLayout>
</LinearLayout>
