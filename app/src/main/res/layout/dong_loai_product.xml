<?xml version="1.0" encoding="utf-8"?>
<!-- Ô danh mục trên trang chủ: biểu tượng tròn + tên bên dưới -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/item_loai_product"
    android:layout_width="78dp"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingVertical="4dp">

    <TextView
        android:id="@+id/tv_loai_icon"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:background="@drawable/bg_category_icon"
        android:gravity="center"
        android:text="🥬"
        android:textColor="#FF000000"
        android:textSize="26sp" />

    <TextView
        android:id="@+id/tv_loai_product"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:fontFamily="@font/be_vietnam_pro" android:textFontWeight="500"
        android:gravity="center"
        android:maxLines="2"
        android:text="Rau củ"
        android:textColor="#1A1A1A"
        android:textSize="12sp" />
</LinearLayout>
