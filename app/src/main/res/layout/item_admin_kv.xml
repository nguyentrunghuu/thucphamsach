<?xml version="1.0" encoding="utf-8"?>
<!-- Một dòng "nhãn ........ giá trị" trong thẻ thông tin trang admin -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/tv_kv_label"
        style="@style/Admin.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/admin_space_l"
        android:maxWidth="140dp"
        android:textColor="@color/admin_text_muted" />

    <TextView
        android:id="@+id/tv_kv_value"
        style="@style/Admin.Text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="end"
        android:textIsSelectable="true" />
</LinearLayout>
