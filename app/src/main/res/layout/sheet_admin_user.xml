<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom sheet thông tin khách hàng (AdminUsersActivity) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/admin_surface"
    android:orientation="vertical"
    android:paddingStart="@dimen/admin_space_xl"
    android:paddingTop="@dimen/admin_space_l"
    android:paddingEnd="@dimen/admin_space_xl"
    android:paddingBottom="@dimen/admin_space_l">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_admin_badge"
        android:backgroundTint="@color/admin_outline" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/admin_space_l"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/cir_sheet_user"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_user"
            app:civ_border_color="@color/ui_stroke"
            app:civ_border_width="1dp"
            app:civ_circle_background_color="@color/admin_beige" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/admin_space_l"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_sheet_user_name"
                style="@style/Admin.Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                tools:text="Nguyễn Trung Hữu" />

            <TextView
                android:id="@+id/tv_sheet_user_email"
                style="@style/Admin.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="nthuu070704@gmail.com" />
        </LinearLayout>
    </LinearLayout>

    <!-- Thống kê mua hàng -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/admin_space_l"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_admin_icon_box"
            android:orientation="vertical"
            android:padding="@dimen/admin_space_m">

            <TextView
                android:id="@+id/tv_sheet_orders"
                style="@style/Admin.Text.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/admin_accent_text"
                tools:text="3" />

            <TextView
                style="@style/Admin.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Đơn đã đặt" />
        </LinearLayout>

        <Space
            android:layout_width="@dimen/admin_space_s"
            android:layout_height="0dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_admin_icon_box"
            android:orientation="vertical"
            android:padding="@dimen/admin_space_m">

            <TextView
                android:id="@+id/tv_sheet_spent"
                style="@style/Admin.Text.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/admin_accent_text"
                tools:text="3" />

            <TextView
                style="@style/Admin.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Đã chi tiêu (đơn đã giao)" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/box_user_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/admin_space_m"
        android:orientation="vertical" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/admin_space_l"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_user_copy"
            style="@style/Admin.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/admin_space_xs"
            android:layout_weight="1"
            android:text="Sao chép email" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_user_call"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/admin_space_xs"
            android:layout_weight="1"
            android:text="Gọi điện"
            app:icon="@drawable/ic_ui_call"
            app:iconTint="@color/white" />
    </LinearLayout>
</LinearLayout>
