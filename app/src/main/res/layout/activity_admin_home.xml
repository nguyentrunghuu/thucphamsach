<?xml version="1.0" encoding="utf-8"?>
<!-- Dashboard admin: đầu trang xanh → 4 thẻ số liệu → lưới chức năng → sản phẩm cần chú ý -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/home_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/admin_beige"
    android:fillViewport="true"
    tools:context=".View.Admin.AdminHomeActivity">

    <LinearLayout
        android:id="@+id/home_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/admin_space_xl">

        <!-- ===== Đầu trang ===== -->
        <LinearLayout
            android:id="@+id/home_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_admin_header"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="@dimen/admin_space_l"
            android:paddingEnd="@dimen/admin_space_s"
            android:paddingBottom="60dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Admin.Text.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Xin chào, Quản trị viên"
                        android:textColor="@color/white" />

                    <TextView
                        android:id="@+id/tv_home_date"
                        style="@style/Admin.Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/admin_on_header_soft"
                        android:textSize="13sp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btn_sign_out"
                    android:layout_width="@dimen/admin_touch_min"
                    android:layout_height="@dimen/admin_touch_min"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Đăng xuất"
                    android:src="@drawable/ic_sign_out"
                    android:tint="@color/white" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_home_summary"
                style="@style/Admin.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/admin_space_m"
                android:textColor="@color/white"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- ===== Thẻ số liệu (đè lên đầu trang) ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-44dp"
            android:orientation="vertical"
            android:paddingStart="@dimen/admin_screen_padding"
            android:paddingEnd="@dimen/admin_screen_padding">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <include
                    android:id="@+id/stat_revenue_today"
                    layout="@layout/item_admin_stat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/stat_revenue_month"
                    layout="@layout/item_admin_stat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/admin_card_gap"
                android:orientation="horizontal">

                <include
                    android:id="@+id/stat_pending"
                    layout="@layout/item_admin_stat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/stat_low_stock"
                    layout="@layout/item_admin_stat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== Lưới chức năng ===== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/admin_screen_padding"
            android:layout_marginTop="@dimen/admin_space_l"
            android:layout_marginEnd="@dimen/admin_screen_padding">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/admin_space_s"
                android:paddingTop="@dimen/admin_card_padding"
                android:paddingEnd="@dimen/admin_space_s"
                android:paddingBottom="@dimen/admin_space_s">

                <TextView
                    style="@style/Admin.Text.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/admin_space_s"
                    android:layout_marginBottom="@dimen/admin_space_s"
                    android:text="Quản lý" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <include android:id="@+id/menu_orders" layout="@layout/item_admin_menu"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                    <include android:id="@+id/menu_products" layout="@layout/item_admin_menu"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                    <include android:id="@+id/menu_categories" layout="@layout/item_admin_menu"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                    <include android:id="@+id/menu_promotions" layout="@layout/item_admin_menu"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <include android:id="@+id/menu_users" layout="@layout/item_admin_menu"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                    <include android:id="@+id/menu_shippers" layout="@layout/item_admin_menu"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                    <include android:id="@+id/menu_stats" layout="@layout/item_admin_menu"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                    <include android:id="@+id/menu_chat" layout="@layout/item_admin_menu"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <include android:id="@+id/menu_ai" layout="@layout/item_admin_menu"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                    <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="3" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== Sản phẩm cần chú ý ===== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/admin_screen_padding"
            android:layout_marginTop="@dimen/admin_space_l"
            android:layout_marginEnd="@dimen/admin_screen_padding">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/admin_card_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="@dimen/admin_space_s"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_admin_warning"
                        android:tint="@color/admin_warning" />

                    <TextView
                        style="@style/Admin.Text.Section"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Cần chú ý" />

                    <TextView
                        android:id="@+id/tv_attention_count"
                        style="@style/Admin.Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rcv_attention"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/admin_space_s"
                    android:nestedScrollingEnabled="false" />

                <include layout="@layout/view_admin_empty" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_attention_more"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAllCaps="false"
                    android:textColor="@color/admin_primary"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== Giao diện sáng / tối ===== -->
        <include
            layout="@layout/view_theme_picker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/admin_screen_padding"
            android:layout_marginTop="@dimen/admin_space_l"
            android:layout_marginEnd="@dimen/admin_screen_padding"
            android:layout_marginBottom="@dimen/admin_space_l" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
