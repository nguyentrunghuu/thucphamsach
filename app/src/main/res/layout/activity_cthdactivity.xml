<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F8F5">

    <!-- THANH TIÊU ĐỀ -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F6F8F5"
        app:elevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:id="@+id/img_back_cthd"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_fav_circle"
                android:contentDescription="Quay lại"
                android:elevation="2dp"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:padding="10dp"
                android:src="@drawable/ic_ui_back"
                app:tint="#1A1A1A" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:fontFamily="@font/be_vietnam_pro"
                android:text="Chi tiết đơn hàng"
                android:textColor="#1A1A1A"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="110dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <!-- TRẠNG THÁI + TỔNG TIỀN -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="#EDF2ED"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Trạng thái"
                            android:textColor="#7A847A"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tv_trangthai_cthd"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill_orange_light"
                            android:fontFamily="@font/be_vietnam_pro"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="5dp"
                            android:text="Đang xử lý"
                            android:textColor="#E65100"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Tổng thanh toán"
                        android:textColor="#7A847A"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_tongtien_cthd"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/be_vietnam_pro"
                            android:text="0"
                            android:textColor="#E65100"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/be_vietnam_pro"
                            android:text=" đ"
                            android:textColor="#E65100"
                            android:textSize="17sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- THÔNG TIN ĐƠN HÀNG -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="#EDF2ED"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="@font/be_vietnam_pro"
                        android:text="Thông tin giao hàng"
                        android:textColor="#1A1A1A"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- Mỗi dòng: nhãn ở trên, giá trị ở dưới -> không bao giờ bị bóp chữ -->
                    <TextView style="@style/OrderLabel" android:text="👤  Người nhận" />
                    <TextView android:id="@+id/tv_hoten_cthd" style="@style/OrderValue" android:text="Tên" />

                    <TextView style="@style/OrderLabel" android:text="📞  Số điện thoại" />
                    <TextView android:id="@+id/tv_sdt_cthd" style="@style/OrderValue" android:text="0123" />

                    <TextView style="@style/OrderLabel" android:text="📍  Địa chỉ" />
                    <TextView android:id="@+id/tv_diachi_cthd" style="@style/OrderValue" android:text="Địa chỉ" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:background="#F0F3F0" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView style="@style/OrderLabel" android:text="Ngày đặt" />
                            <TextView android:id="@+id/tv_ngaydat_cthd" style="@style/OrderValue" android:text="01/01/2026" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.4"
                            android:orientation="vertical">

                            <TextView style="@style/OrderLabel" android:text="Mã đơn" />
                            <TextView
                                android:id="@+id/tv_ma_cthd"
                                style="@style/OrderValue"
                                android:ellipsize="middle"
                                android:singleLine="true"
                                android:text="ABC123"
                                android:textColor="#1A1A1A" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SẢN PHẨM ĐÃ ĐẶT -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp"
                android:fontFamily="@font/be_vietnam_pro"
                android:text="Sản phẩm đã đặt"
                android:textColor="#1A1A1A"
                android:textSize="16sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rcv_cthd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- NÚT HỦY ĐƠN (chỉ hiện khi đơn đang xử lý) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_bar"
        android:elevation="12dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <Button
            android:id="@+id/btn_capnhat_cthd"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_danger_outline_button"
            android:fontFamily="@font/be_vietnam_pro"
            android:letterSpacing="0"
            android:stateListAnimator="@null"
            android:text="Hủy đơn hàng"
            android:textAllCaps="false"
            android:textColor="#C62828"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />
    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
