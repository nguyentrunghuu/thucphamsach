<?xml version="1.0" encoding="utf-8"?>
<!-- Một khách hàng trong danh sách admin — AdminUsersAdapter -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/admin_space_s"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="@dimen/admin_radius_field">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/admin_space_m">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/cir_user"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@drawable/ic_user"
            app:civ_border_color="@color/ui_stroke"
            app:civ_border_width="1dp"
            app:civ_circle_background_color="@color/admin_beige" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/admin_space_m"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_user_name"
                style="@style/Admin.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Nguyễn Trung Hữu" />

            <TextView
                android:id="@+id/tv_user_email"
                style="@style/Admin.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="nthuu070704@gmail.com" />

            <TextView
                android:id="@+id/tv_user_phone"
                style="@style/Admin.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="0923232340" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/admin_space_s"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_user_orders"
                style="@style/Admin.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/admin_accent_text"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="3 đơn" />

            <TextView
                android:id="@+id/tv_user_spent"
                style="@style/Admin.Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                tools:text="1,2tr" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
