<?xml version="1.0" encoding="utf-8"?>
<!-- Ô chức năng trong lưới "Quản lý" của dashboard (dùng qua <include>); gán trong AdminHomeActivity.bindMenu -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:minHeight="88dp"
    android:orientation="vertical"
    android:paddingTop="@dimen/admin_space_s"
    android:paddingBottom="@dimen/admin_space_s">

    <FrameLayout
        android:id="@+id/menu_icon_box"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_admin_icon_box">

        <ImageView
            android:id="@+id/menu_icon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <TextView
        android:id="@+id/menu_label"
        style="@style/Admin.Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:maxLines="2"
        android:textSize="12sp" />
</LinearLayout>
