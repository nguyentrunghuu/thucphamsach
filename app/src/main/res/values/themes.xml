<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.DoAn_TMDT" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color - Blue -->
        <item name="colorPrimary">@color/primary_blue</item>
        <item name="colorPrimaryVariant">@color/primary_blue_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        
        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/primary_blue_light</item>
        <item name="colorSecondaryVariant">@color/primary_blue_darker</item>
        <item name="colorOnSecondary">@color/white</item>
        
        <!-- Background colors -->
        <item name="android:colorBackground">@color/background_light</item>
        <item name="colorSurface">@color/background_white</item>
        
        <!-- Status bar color -->
        <item name="android:statusBarColor" tools:targetApi="l">@color/primary_blue</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        
        <!-- Text colors -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        
        <!-- Error color -->
        <item name="colorError">@color/error_red</item>

        <!-- Font chữ toàn app: Be Vietnam Pro (không phụ thuộc font hệ thống của điện thoại) -->
        <item name="android:fontFamily">@font/be_vietnam_pro</item>
        <item name="fontFamily">@font/be_vietnam_pro</item>
        <item name="android:textViewStyle">@style/AppTextView</item>
        <item name="editTextStyle">@style/AppEditText</item>
        <item name="materialButtonStyle">@style/AppButton</item>

        <!-- Bo góc mềm cho các thành phần Material -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeSmall</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeMedium</item>
    </style>

    <style name="AppTextView" parent="Widget.AppCompat.TextView">
        <item name="android:fontFamily">@font/be_vietnam_pro</item>
    </style>

    <style name="AppEditText" parent="Widget.AppCompat.EditText">
        <item name="android:fontFamily">@font/be_vietnam_pro</item>
    </style>

    <style name="AppButton" parent="Widget.MaterialComponents.Button">
        <item name="android:fontFamily">@font/be_vietnam_pro</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="ShapeSmall" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerSize">14dp</item>
    </style>

    <style name="ShapeMedium" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerSize">20dp</item>
    </style>

    <!-- ===== Kiểu chữ dùng chung cho giao diện mới ===== -->
    <style name="Text">
        <item name="android:fontFamily">@font/be_vietnam_pro</item>
    </style>

    <style name="Text.H1">
        <item name="android:fontFamily">@font/be_vietnam_pro</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.Section">
        <item name="android:fontFamily">@font/be_vietnam_pro</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.Body">
        <item name="android:fontFamily">@font/be_vietnam_pro</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.Caption">
        <item name="android:fontFamily">@font/be_vietnam_pro</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Text.Price">
        <item name="android:fontFamily">@font/be_vietnam_pro</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/accent_orange</item>
    </style>

    <style name="Text.Link">
        <item name="android:fontFamily">@font/be_vietnam_pro</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/primary_green_light</item>
    </style>

    <style name="CollapsingToolbarLayoutExpandedTextStyle" parent="AppTheme">
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">20dp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="foodRatingBar" parent="@android:style/Widget.RatingBar">
        <item name="android:progressDrawable">@drawable/ic_star_on</item>
        <item name="android:minHeight">10dp</item>
        <item name="android:maxHeight">10dp</item>
    </style>

    <!-- Tiêu đề màn chi tiết sản phẩm -->
    <style name="DetailExpandedTitle" parent="TextAppearance.AppCompat.Title">
        <item name="android:fontFamily">@font/be_vietnam_pro</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <style name="DetailCollapsedTitle" parent="TextAppearance.AppCompat.Title">
        <item name="android:fontFamily">@font/be_vietnam_pro</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <!-- ===== Chatbot: nút gợi ý nhanh ===== -->
    <style name="ChatSuggestion">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/bg_chat_suggestion</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:textColor">#1B5E20</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textFontWeight">500</item>
    </style>

    <!-- ===== Trang hồ sơ ===== -->
    <style name="ProfileLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">#7A847A</item>
        <item name="android:textFontWeight">500</item>
    </style>

    <!-- ===== Tìm kiếm: chip lọc/sắp xếp + nút công cụ ===== -->
    <style name="SearchChip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="chipStrokeColor">@color/chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textAppearance">@style/SearchChipText</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="chipMinHeight">36dp</item>
        <item name="chipCornerRadius">100dp</item>
        <item name="android:checkable">true</item>
        <item name="checkedIconVisible">false</item>
        <item name="rippleColor">#1A2E7D32</item>
    </style>

    <!-- Chip lấy font từ textAppearance (không đọc android:fontFamily trực tiếp) -->
    <style name="SearchChipText" parent="TextAppearance.MaterialComponents.Chip">
        <item name="android:fontFamily">@font/be_vietnam_pro</item>
        <item name="fontFamily">@font/be_vietnam_pro</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/chip_text</item>
    </style>

    <style name="SearchToolButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:background">@drawable/bg_tool_button</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:drawableTint">#2E7D32</item>
        <item name="android:textColor">#1A1A1A</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textFontWeight">600</item>
    </style>

    <!-- ===== Chi tiết đơn hàng ===== -->
    <style name="OrderLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">#7A847A</item>
    </style>

    <style name="OrderValue">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">#1A1A1A</item>
        <item name="android:textFontWeight">600</item>
    </style>

    <!-- ===== Hộp thanh toán ===== -->
    <style name="DialogSectionTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:fontFamily">@font/be_vietnam_pro</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#1A1A1A</item>
    </style>

    <style name="DialogInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:background">@drawable/bg_input_rounded</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#1A1A1A</item>
        <item name="android:textColorHint">#9AA39A</item>
        <item name="android:importantForAutofill">no</item>
    </style>

    <style name="DialogRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <style name="DialogRowLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#7A847A</item>
    </style>

    <style name="DialogRowValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#1A1A1A</item>
        <item name="android:textFontWeight">600</item>
    </style>

    <style name="DialogRowUnit">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:text">" đ"</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#1A1A1A</item>
    </style>

    <!-- =====================================================================
         TRANG ADMIN — theme + style dùng chung (gán cho các activity View.Admin.* trong Manifest).
         Màu ở colors.xml (admin_*), kích thước ở dimens_admin.xml.
         ===================================================================== -->
    <style name="Theme.ThucPhamXanh.Admin" parent="Theme.DoAn_TMDT">
        <item name="colorPrimary">@color/admin_primary</item>
        <item name="colorPrimaryVariant">@color/admin_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/admin_secondary</item>
        <item name="colorSecondaryVariant">@color/admin_secondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorAccent">@color/admin_primary</item>
        <item name="android:colorBackground">@color/admin_beige</item>
        <item name="android:windowBackground">@color/admin_beige</item>
        <item name="colorSurface">@color/admin_surface</item>
        <item name="android:statusBarColor">@color/admin_primary_dark</item>
        <item name="android:textColorPrimary">@color/admin_text</item>
        <item name="android:textColorSecondary">@color/admin_text_muted</item>
        <item name="colorError">@color/admin_danger</item>

        <item name="materialCardViewStyle">@style/Admin.Card</item>
        <item name="textInputStyle">@style/Admin.TextField</item>
        <item name="chipStyle">@style/Admin.Chip.Filter</item>
        <item name="materialButtonStyle">@style/Admin.Button</item>
        <!-- Toolbar: dùng style="@style/Admin.Toolbar" trực tiếp trong layout (không gán toàn theme
             để các toolbar cũ chưa làm lại giữ nguyên màu của chúng). -->
    </style>

    <!-- Gốc rỗng để các style "Admin.*" kế thừa theo tên -->
    <style name="Admin" />

    <style name="Admin.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">@dimen/admin_radius_card</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/admin_outline</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardBackgroundColor">@color/admin_surface</item>
    </style>

    <style name="Admin.Toolbar" parent="Widget.MaterialComponents.Toolbar.Primary">
        <item name="android:background">@color/admin_primary</item>
        <item name="titleTextColor">@color/white</item>
        <item name="titleTextAppearance">@style/Admin.Text.ToolbarTitle</item>
    </style>

    <style name="Admin.TextField" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/admin_radius_field</item>
        <item name="boxCornerRadiusTopEnd">@dimen/admin_radius_field</item>
        <item name="boxCornerRadiusBottomStart">@dimen/admin_radius_field</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/admin_radius_field</item>
        <item name="boxStrokeColor">@color/admin_primary</item>
        <item name="hintTextColor">@color/admin_primary</item>
        <item name="boxBackgroundColor">@color/admin_surface</item>
    </style>

    <style name="Admin.Chip.Filter" parent="Widget.MaterialComponents.Chip.Filter">
        <item name="chipBackgroundColor">@color/admin_chip_bg</item>
        <item name="chipStrokeColor">@color/admin_outline</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/admin_chip_text</item>
        <item name="checkedIconTint">@color/admin_primary_dark</item>
        <item name="android:fontFamily">@font/be_vietnam_pro</item>
    </style>

    <style name="Admin.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">@dimen/admin_radius_field</item>
        <item name="android:minHeight">@dimen/admin_touch_min</item>
        <item name="android:fontFamily">@font/be_vietnam_pro</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- Nút viền (hủy, thao tác phụ) -->
    <style name="Admin.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">@dimen/admin_radius_field</item>
        <item name="android:minHeight">@dimen/admin_touch_min</item>
        <item name="strokeColor">@color/admin_primary</item>
        <item name="android:textColor">@color/admin_primary</item>
        <item name="android:fontFamily">@font/be_vietnam_pro</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- Kiểu chữ trang admin -->
    <style name="Admin.Text">
        <item name="android:fontFamily">@font/be_vietnam_pro</item>
        <item name="android:textColor">@color/admin_text</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Admin.Text.ToolbarTitle">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Admin.Text.Title">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Admin.Text.Section">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Admin.Text.StatValue">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/admin_primary_dark</item>
    </style>

    <style name="Admin.Text.Body" />

    <style name="Admin.Text.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/admin_text_muted</item>
    </style>

    <!-- Bo góc ảnh (ShapeableImageView app:shapeAppearanceOverlay) -->
    <style name="Admin.Shape.Rounded" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">10dp</item>
    </style>

    <!-- Nhãn nhỏ dạng "viên thuốc" (tồn kho, hạn dùng, trạng thái) — đặt màu nền bằng backgroundTint -->
    <style name="Admin.Badge">
        <item name="android:fontFamily">@font/be_vietnam_pro</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:background">@drawable/bg_admin_badge</item>
    </style>
</resources>
